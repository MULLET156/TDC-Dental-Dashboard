# TDC Dental Dashboard settings. Copy this file to ".env" and fill it in.
# Never commit .env. On Hostinger, put these in the app's Environment Variables instead.

# "design" (Hostinger, fake data only) or "live" (office server)
TDC_STAGE=design

# HTTPS. "on" = the Dashboard serves HTTPS itself (this computer, office server).
# "off" = something in front of it already does HTTPS (Hostinger). Then also set TRUST_PROXY=1.
TLS=on
TLS_CERT=certs/dev-cert.pem
TLS_KEY=certs/dev-key.pem
TRUST_PROXY=0

# Where to listen. Testing on this computer: 127.0.0.1 and 8443.
# Office server: HOST=0.0.0.0 and PORT=443. Hostinger sets PORT for you.
HOST=127.0.0.1
PORT=8443

# The address staff type, e.g. https://office.toledodentalcare.com (used to check that
# form posts come from this site). Leave empty to use the address in the browser.
PUBLIC_URL=

# Where staff accounts and settings are saved (never committed).
DATA_DIR=data

# First-run setup code. Needed once, to create the owner account.
# Leave empty on your own computer: a code is written to data/SETUP-CODE.txt.
# On Hostinger, set it to something only you know.
SETUP_CODE=

# 1 = also run the built-in sample "Hello" module, so there's something to see.
DEMO_HELLO=1

# --- Live stage only: automatic Let's Encrypt certificate (see docs/CERTIFICATE.md) ---
# ACME_DOMAIN=office.toledodentalcare.com
# ACME_EMAIL=
# ACME_DNS=acme-dns
# ACME_DNS_API=https://auth.acme-dns.io
# (the acme-dns username/password/subdomain are saved in data/acme/ by "npm run get-cert", not here)
